{
    "name": "desktop",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "sourceRoot": "apps/desktop/src",
    "projectType": "application",
    "tags": [],
    "implicitDependencies": ["backend", "frontend"],
    "targets": {
        "build": {
            "executor": "nx:run-commands",
            "dependsOn": [{ "projects": ["frontend"], "target": "build" }],
            "outputs": ["{workspaceRoot}/dist/apps/desktop"],
            "options": {
                "command": "node tools/desktop/build.mjs"
            }
        },
        "typecheck": {
            "executor": "nx:run-commands",
            "options": {
                "command": "tsc -p apps/desktop/tsconfig.app.json --noEmit"
            }
        },
        "serve": {
            "executor": "nx:run-commands",
            "dependsOn": ["build"],
            "options": {
                "command": "electron dist/apps/desktop"
            }
        },
        "package": {
            "executor": "nx:run-commands",
            "dependsOn": ["build"],
            "outputs": ["{workspaceRoot}/dist/desktop"],
            "options": {
                "command": "electron-builder --config apps/desktop/electron-builder.json --win"
            }
        }
    }
}
