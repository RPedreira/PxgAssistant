{
    "name": "@pxg-assistant/source",
    "version": "0.0.0",
    "license": "MIT",
    "scripts": {
        "dev": "nx run-many -t serve -p backend frontend --parallel=2 --output-style=stream",
        "test": "nx run-many -t test -p shared backend frontend",
        "build": "nx run-many -t build -p backend frontend",
        "desktop": "nx serve desktop",
        "desktop:dist": "nx package desktop",
        "desktop:icon": "python tools/desktop/make-icon.py",
        "db:seed": "ts-node --transpile-only -r tsconfig-paths/register --project tools/tsconfig.tools.json tools/scripts/seed-joey-quest.ts",
        "wiki:import": "ts-node --transpile-only -r tsconfig-paths/register --project tools/tsconfig.tools.json tools/scripts/import-wiki.ts",
        "sprites:import": "ts-node --transpile-only -r tsconfig-paths/register --project tools/tsconfig.tools.json tools/scripts/import-sprites.ts"
    },
    "private": true,
